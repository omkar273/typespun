# Copy to .env. The server refuses to start without APP_ADMIN_TOKEN.
APP_ADMIN_TOKEN=replace-with-a-development-value

# Anything below overrides config/config.yaml.
# APP_SERVER_PORT=8787
# APP_LOG_LEVEL=debug
# Array values are read as JSON, not as a comma-separated list.
# APP_CORS_ORIGINS=["http://localhost:5173","https://app.example.com"]
# DATABASE_URL=postgres://localhost:5432/typespun_example
