# Copy to .env. The server refuses to start without APP_SESSION_SECRET.
APP_SESSION_SECRET=replace-with-a-development-value

# Anything below overrides the inline @default values in src/config.ts.
# APP_SERVER_PORT=8080
# APP_LOGGER_LEVEL=debug
# Array values are read as JSON, not as a comma-separated list.
# APP_CORS_ORIGINS=["http://localhost:5173","https://app.example.com"]
# DATABASE_URL=postgres://localhost:5432/typespun_example
