{
  "name": "typespun-example-with-express",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "config:check": "bun ../../packages/codegen/dist/bin.js check",
    "config:generate": "bun ../../packages/codegen/dist/bin.js generate",
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "5.2.1",
    "typespun": "workspace:*"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "26.6.2",
    "typescript": "6.0.3",
    "typespun-codegen": "workspace:*"
  }
}
