{
  "name": "typespun",
  "version": "0.1.2",
  "description": "Type-safe configuration for TypeScript: the runtime behind generated loaders that validate environment variables, dotenv, and defaults.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkar273/typespun.git",
    "directory": "packages/typespun"
  },
  "homepage": "https://github.com/omkar273/typespun#readme",
  "bugs": "https://github.com/omkar273/typespun/issues",
  "keywords": [
    "configuration",
    "config",
    "typed-config",
    "type-safe",
    "environment",
    "environment-variables",
    "env",
    "dotenv",
    "validation",
    "typescript",
    "nodejs",
    "bun",
    "12-factor"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.1"
  },
  "sideEffects": false,
  "bin": {
    "typespun": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./generated": {
      "import": {
        "types": "./dist/generated.d.ts",
        "default": "./dist/generated.js"
      },
      "require": {
        "types": "./dist/generated.d.cts",
        "default": "./dist/generated.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit --types bun"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
