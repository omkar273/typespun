{
  "name": "typespun",
  "version": "0.1.0",
  "description": "Typed, generated configuration loading for TypeScript",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkar273/typespun.git",
    "directory": "packages/typespun"
  },
  "homepage": "https://github.com/omkar273/typespun#readme",
  "bugs": "https://github.com/omkar273/typespun/issues",
  "keywords": [
    "configuration",
    "environment",
    "typescript",
    "typed-config"
  ],
  "engines": {
    "node": ">=22 <23 || >=24 <25",
    "bun": ">=1.4.1"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./generated": {
      "types": "./dist/generated.d.ts",
      "import": "./dist/generated.js",
      "require": "./dist/generated.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit --types bun"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
